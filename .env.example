# Copy to .env and fill in what you need. Everything has a sensible default.

# ---- LLM (pick one; with none set the system runs in extractive mode) ----
# LLM_PROVIDER=auto            # auto | anthropic | openai | extractive
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5   # default for the anthropic provider
#
# Any OpenAI-compatible endpoint, e.g. a local Ollama server:
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# OPENAI_API_KEY=...            # if the endpoint needs one

# ---- Embeddings ----
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_MODEL_PATH=          # local ONNX model folder for offline machines

# ---- Qdrant ----
# QDRANT_URL=http://localhost:6333   # unset = embedded on-disk Qdrant in storage/qdrant
# QDRANT_COLLECTION=india_earthquake_kb

# ---- Retrieval ----
# TOP_K=8
# MIN_DENSE_SCORE=0.60         # below this best cosine the question is treated as out of scope
# MAX_CHUNKS_PER_SOURCE=4
# QUERY_REWRITE=none           # none | llm

# ---- Data ----
# DATA_DIR=data
